NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Neon: pooled string (host contains "-pooler") for the app, direct string for migrations.
# Local Docker alternative: postgres://coinhub:coinhub@localhost:5432/coinhub
DATABASE_URL=postgres://coinhub:coinhub@localhost:5432/coinhub
DATABASE_URL_DIRECT=postgres://coinhub:coinhub@localhost:5432/coinhub
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379

# Background jobs (run the worker with `npm run worker`; `npm run dev` starts it too)
QUEUE_PREFIX=coinhub
EMAIL_BACKOFF_MS=5000
OUTBOX_POLL_MS=1000
PAYOUT_DELAY_MS=2000

# Money transactions fail fast (503) instead of hanging if a row lock is held this long
LOCK_TIMEOUT_MS=5000

# Secrets: generate with `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
CSRF_SECRET=change-me-change-me-change-me-change-me
GATEWAY_WEBHOOK_SECRET=change-me-change-me-change-me-change-me

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Mail (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MobilePay <no-reply@mobilepay.local>"

# Seed data
SEED_ADMIN_EMAIL=admin@mobilepay.local
SEED_ADMIN_PASSWORD=Admin@12345
